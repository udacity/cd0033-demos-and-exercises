# Copy this file to .env (in this repo or parent workspace) and fill in your AWS credentials.
# .env is gitignored and will be auto-loaded by setup_aws.py and Step 0 in exercise notebooks.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

CARDINAL_AWS_REGION=us-east-1
CARDINAL_LF_LIVE=1

